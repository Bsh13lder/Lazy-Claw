<?xml version="1.0" encoding="utf-8"?>
<!-- Metadata for the LazyClaw Quick-Capture home-screen widget (4x1). Pure
     launcher buttons, so no periodic updates are needed (updatePeriodMillis=0;
     onUpdate only re-binds the click intents). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/quick_capture_widget"
    android:previewLayout="@layout/quick_capture_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/qc_widget_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
