<?xml version="1.0" encoding="utf-8"?>
<!-- Metadata for the LazyClaw "Today tasks" home-screen widget (~4x2).
     updatePeriodMillis=0: the snapshot is pushed from the Flutter side on every
     task change (HomeWidget.updateWidget), so no system polling is needed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/tasks_widget"
    android:previewLayout="@layout/tasks_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/tw_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
