<?xml version="1.0" encoding="utf-8"?>
<!-- LazyClaw "Today tasks" home-screen widget (~4x2). A header (brand + Add
     button) over a fixed 3-row task list (accent bullet · title · due pill)
     and a "+N more" footer. The whole body deep-links to the Tasks page; the
     Add button deep-links to the add-task flow. Click intents are wired in
     TasksWidget.kt.
     RemoteViews-safe: LinearLayout + TextView only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/quick_capture_bg"
    android:padding="12dp">

    <!-- Header: title + "+ Add" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tw_title"
            android:textColor="@color/lz_widget_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <!-- Last-repaint stamp ("19:42") — freshness at a glance, and the
             tell when diagnosing a frozen widget: stamp moving + empty rows =
             data path; no stamp at all = launcher never delivered onUpdate.
             Hidden until the app writes its first snapshot. -->
        <TextView
            android:id="@+id/tw_stamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="@color/lz_widget_muted"
            android:textSize="10sp"
            android:maxLines="1"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tw_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tw_add"
            android:textColor="@color/lz_widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/tasks_widget_add_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:contentDescription="@string/tw_add" />
    </LinearLayout>

    <!-- Task rows (fixed 3). Each row: accent bullet · title · due pill. -->
    <LinearLayout
        android:id="@+id/tw_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:baselineAligned="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tw_bullet"
            android:textColor="@color/lz_accent"
            android:textSize="9sp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/tw_row0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/lz_widget_label"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tw_row0_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/lz_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/tasks_widget_due_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:baselineAligned="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tw_bullet"
            android:textColor="@color/lz_accent"
            android:textSize="9sp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/tw_row1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/lz_widget_label"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tw_row1_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/lz_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/tasks_widget_due_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:baselineAligned="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tw_bullet"
            android:textColor="@color/lz_accent"
            android:textSize="9sp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/tw_row2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/lz_widget_label"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/tw_row2_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/lz_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/tasks_widget_due_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- Footer: "+N more" overflow count (hidden when everything fits). -->
    <TextView
        android:id="@+id/tw_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="17dp"
        android:textColor="@color/lz_widget_muted"
        android:textSize="11sp"
        android:maxLines="1"
        android:visibility="gone" />

    <!-- Empty state — shown (and rows hidden) when there are no open tasks. -->
    <TextView
        android:id="@+id/tw_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/tw_empty"
        android:textColor="@color/lz_widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
