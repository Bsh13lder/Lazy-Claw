# LazyClaw HTTPS front door — fully self-owned.
#
# Caddy terminates TLS with a REAL Let's Encrypt certificate, obtained over
# the forwarded router port (TLS-ALPN-01 on :443, HTTP-01 on :80 as fallback).
# DuckDNS only provides the name → home-IP DNS record; NO third party is in the
# traffic path and NO third party ever decrypts application data.
#
# Traffic path: phone --TLS--> home router (:443) --> Mac:443 --> Caddy (TLS
# terminates HERE, on your hardware) --> lazyclaw-web (nginx, serves the SPA
# and proxies /api + /ws to the lazyclaw gateway). reverse_proxy upgrades
# WebSockets automatically.
#
# Prereqs (see docs/REMOTE_ACCESS.md): a DuckDNS subdomain pointed at the home
# IP (kept fresh by scripts/duckdns-update.sh), and the router forwarding TCP
# 80 + 443 to the Mac's LAN IP.

{
	# ACME account email — renewal + expiry notices. Set in .env.
	email {$ACME_EMAIL}
}

{$LAZYCLAW_DOMAIN:lazyclaw.duckdns.org} {
	tls {
		# DNS-01 via DuckDNS: prove domain ownership with a TXT record, so NO
		# inbound port (80/443) is needed for the cert. Required because the
		# Vodafone router reserves public 80/443 for its own admin — external
		# traffic reaches us on 8443 instead, mapped to this container's 443.
		dns duckdns {$DUCKDNS_TOKEN}
	}
	encode zstd gzip

	# nginx already routes the SPA, /api/* and /ws/* internally, so we hand it
	# the whole request surface. reverse_proxy upgrades WebSockets automatically.
	reverse_proxy lazyclaw-web:80
}
